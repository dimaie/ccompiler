{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "type": "shell",
      "label": "CMake: Configure",
      "command": "cmake -B build -S .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "type": "shell",
      "label": "CMake: Build",
      "command": "cmake --build build --config Debug",
      "dependsOn": "CMake: Configure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "CMake: Clean",
      "command": "cmake --build build --target clean --config Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "CMake: Rebuild",
      "dependsOrder": "sequence",
      "dependsOn": ["CMake: Clean", "CMake: Build"],
      "problemMatcher": ["$msCompile"],
      "group": "build"
    },
    {
      "type": "shell",
      "label": "CMake: Hard Clean (Purge Build Dir)",
      "command": "Remove-Item -Path build\\CMakeCache.txt -Force -ErrorAction SilentlyContinue; Remove-Item -Path build\\CMakeFiles -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -Path build -Recurse -Force -ErrorAction SilentlyContinue",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "CMake: Run Tests (CTest)",
      "command": "ctest --test-dir build -C Debug --output-on-failure",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Run Parser Tests (Binary)",
      "command": ".\\build\\Debug\\test_parser.exe",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Run Codegen Tests (Binary)",
      "command": ".\\build\\Debug\\test_codegen.exe",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}