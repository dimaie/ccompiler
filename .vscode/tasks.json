{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "CMake: Configure",
      "command": "cmake -B build -S . -G Ninja -DCMAKE_BUILD_TYPE=Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "type": "shell",
      "label": "CMake: Build",
      "command": "cmake --build build",
      "dependsOn": "CMake: Configure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "CMake: Clean",
      "command": "cmake --build build --target clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "CMake: Rebuild",
      "dependsOrder": "sequence",
      "dependsOn": ["CMake: Clean", "CMake: Build"],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "type": "shell",
      "label": "CMake: Hard Clean (Purge Build Dir)",
      "command": "Remove-Item -Path build\\CMakeCache.txt -Force -ErrorAction SilentlyContinue; Remove-Item -Path build\\CMakeFiles -Recurse -Force -ErrorAction SilentlyContinue; Remove-Item -Path build -Recurse -Force -ErrorAction SilentlyContinue",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "CMake: Run Tests (CTest)",
      "command": "ctest --test-dir build --output-on-failure",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Run Parser Tests (Binary)",
      "command": ".\\build\\test_parser.exe",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Run Codegen Tests (Binary)",
      "command": ".\\build\\test_codegen.exe",
      "dependsOn": "CMake: Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}